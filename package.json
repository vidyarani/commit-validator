{
  "name": "commit-validator",
  "version": "0.1.0",
  "description": "Validate commit messages against organizational quality policies",
  "type": "module",
  "bin": {
    "cv": "./bin/cv.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' || true",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["commit", "validator", "git", "lint"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
