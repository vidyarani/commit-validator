{
  "name": "commit-validator",
  "version": "0.1.0",
  "description": "Validate commit messages against organizational quality policies",
  "type": "module",
  "bin": {
    "cv": "./bin/cv.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' || true",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "commit",
    "validator",
    "git",
    "lint"
  ],
  "author": "Vidya Rani",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
